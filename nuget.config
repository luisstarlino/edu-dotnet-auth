<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin restores to nuget.org so builds are reproducible on any machine or CI
       runner and don't depend on machine-level private feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
